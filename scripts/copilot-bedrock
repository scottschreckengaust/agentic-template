#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "aws-bedrock-token-generator",
# ]
# ///
"""Launch GitHub Copilot CLI against Amazon Bedrock.

With no arguments, the Bedrock model id is read from Copilot's startup
settings and the provider is derived from that id. Credentials come from
AWS_PROFILE when it is set, otherwise from the default AWS chain. A
successful sts get-caller-identity call is required before launch.
"""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

# Dots and slashes would let AWS_REGION change the request host.
AWS_REGION_PATTERN = re.compile(r"^[a-z0-9-]+$")

PROVIDERS = ("claude", "codex", "grok")
CROSS_REGION_PREFIXES = ("global.", "us.", "eu.", "ap.", "in.")


def usage() -> str:
    return (
        "usage: copilot-bedrock [claude|codex|grok] [MODEL] [copilot args...]\n"
        "\n"
        "With no arguments, MODEL is read from Copilot's startup settings and\n"
        "the provider is derived from the model id:\n"
        "  anthropic.* -> claude, openai.* -> codex, xai.* -> grok\n"
        "A cross-region prefix (global., us., eu., ap., in.) is ignored.\n"
        "\n"
        "Settings are checked in the same order Copilot applies them:\n"
        "  1. COPILOT_MODEL\n"
        "  2. .github/copilot/settings.local.json\n"
        "  3. .github/copilot/settings.json\n"
        "  4. ~/.copilot/settings.json (or $COPILOT_HOME/settings.json)\n"
        "The key is \"model\".\n"
        "\n"
        "Credentials use AWS_PROFILE when set, otherwise the default AWS chain.\n"
        "Launch continues only after sts get-caller-identity succeeds.\n"
        "AWS_REGION is used when set; otherwise the region comes from the\n"
        "resolved profile or default AWS config."
    )


def validate_region(region: str) -> str:
    if not AWS_REGION_PATTERN.fullmatch(region):
        sys.exit(f"Refusing AWS region {region!r}. Expected a value like us-east-1.")
    return region


def resolve_region() -> str:
    region = os.environ.get("AWS_REGION") or os.environ.get("AWS_DEFAULT_REGION")
    if region:
        return validate_region(region)

    from botocore.session import Session

    profile = os.environ.get("AWS_PROFILE")
    session = Session(profile=profile) if profile else Session()
    discovered = session.get_config_variable("region")
    if not discovered:
        sys.exit("Set AWS_REGION, or set a region on the AWS profile.")
    return validate_region(discovered)


def is_cross_region(model: str) -> bool:
    return model.startswith(CROSS_REGION_PREFIXES)


def derive_provider(model: str) -> str | None:
    """Map a Bedrock model id to claude, codex, or grok."""
    body = model
    for prefix in CROSS_REGION_PREFIXES:
        if body.startswith(prefix):
            body = body[len(prefix) :]
            break
    if body.startswith("anthropic."):
        return "claude"
    if body.startswith("openai."):
        return "codex"
    if body.startswith("xai."):
        return "grok"
    return None


def parse_invocation(argv: list[str]) -> tuple[str | None, str | None, list[str]]:
    """Return an explicit provider, an explicit model, and Copilot arguments."""
    if not argv:
        return None, None, []
    first, *rest = argv
    if first in PROVIDERS:
        if rest and not rest[0].startswith("-"):
            return first, rest[0], rest[1:]
        return first, None, rest
    if first.startswith("-"):
        return None, None, argv
    return None, first, rest


def smoke_test_credentials(region: str) -> None:
    """Run sts get-caller-identity with the same credential chain Bedrock will use."""
    from botocore.session import Session

    profile = os.environ.get("AWS_PROFILE")
    session = Session(profile=profile) if profile else Session()
    from botocore.exceptions import BotoCoreError, ClientError

    client = session.create_client("sts", region_name=region)
    try:
        identity = client.get_caller_identity()
    except (BotoCoreError, ClientError) as exc:
        sys.exit(f"AWS credential check failed (sts get-caller-identity): {exc}")
    arn = identity.get("Arn", "unknown")
    source = f"profile {profile}" if profile else "default credential chain"
    print(f"copilot-bedrock: sts get-caller-identity ok ({source}): {arn}", file=sys.stderr)


def strip_jsonc(text: str) -> str:
    """Remove // and /* */ comments and trailing commas outside strings."""
    out: list[str] = []
    i = 0
    length = len(text)
    in_string = False
    escape = False
    while i < length:
        char = text[i]
        if in_string:
            out.append(char)
            if escape:
                escape = False
            elif char == "\\":
                escape = True
            elif char == '"':
                in_string = False
            i += 1
            continue
        if char == '"':
            in_string = True
            out.append(char)
            i += 1
            continue
        if char == "/" and i + 1 < length and text[i + 1] == "/":
            i += 2
            while i < length and text[i] not in "\r\n":
                i += 1
            continue
        if char == "/" and i + 1 < length and text[i + 1] == "*":
            i += 2
            while i + 1 < length and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i = min(i + 2, length)
            continue
        out.append(char)
        i += 1

    stripped = "".join(out)
    cleaned: list[str] = []
    i = 0
    length = len(stripped)
    in_string = False
    escape = False
    while i < length:
        char = stripped[i]
        if in_string:
            cleaned.append(char)
            if escape:
                escape = False
            elif char == "\\":
                escape = True
            elif char == '"':
                in_string = False
            i += 1
            continue
        if char == '"':
            in_string = True
            cleaned.append(char)
            i += 1
            continue
        if char == ",":
            j = i + 1
            while j < length and stripped[j] in " \t\r\n":
                j += 1
            if j < length and stripped[j] in "}]":
                i += 1
                continue
        cleaned.append(char)
        i += 1
    return "".join(cleaned)


def model_from_settings(path: Path) -> str | None:
    if not path.is_file():
        return None
    parsed = json.loads(strip_jsonc(path.read_text(encoding="utf-8")))
    if not isinstance(parsed, dict):
        return None
    model = parsed.get("model")
    if isinstance(model, str) and model.strip():
        return model.strip()
    permissions = parsed.get("permissions")
    if isinstance(permissions, dict):
        nested = permissions.get("model")
        if isinstance(nested, str) and nested.strip():
            return nested.strip()
    return None


def find_repo_root(start: Path) -> Path | None:
    current = start.resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".git").exists() or (candidate / ".github").is_dir():
            return candidate
    return None


def model_from_startup_config(start: Path | None = None) -> tuple[str | None, str | None]:
    """Return (model id, source label) from Copilot's startup configuration."""
    from_env = os.environ.get("COPILOT_MODEL", "").strip()
    if from_env:
        return from_env, "COPILOT_MODEL"

    root = find_repo_root(start or Path.cwd())
    if root is not None:
        local = root / ".github" / "copilot" / "settings.local.json"
        repo = root / ".github" / "copilot" / "settings.json"
        for path in (local, repo):
            found = model_from_settings(path)
            if found:
                return found, str(path)

    home = os.environ.get("COPILOT_HOME")
    user_settings = Path(home).expanduser() if home else Path.home() / ".copilot"
    user_file = user_settings / "settings.json"
    found = model_from_settings(user_file)
    if found:
        return found, str(user_file)
    return None, None


def provider_env(provider: str, model: str, region: str) -> dict[str, str]:
    """Return Copilot CLI provider variables for a Bedrock model."""
    cross_region = is_cross_region(model)
    if provider == "claude":
        host = (
            f"https://bedrock-runtime.{region}.amazonaws.com/anthropic"
            if cross_region
            else f"https://bedrock-mantle.{region}.api.aws/anthropic"
        )
        return {
            "COPILOT_PROVIDER_TYPE": "anthropic",
            "COPILOT_PROVIDER_BASE_URL": host,
            "COPILOT_MODEL": model,
        }

    host = (
        f"https://bedrock-runtime.{region}.amazonaws.com/openai/v1"
        if cross_region
        else f"https://bedrock-mantle.{region}.api.aws/openai/v1"
    )
    return {
        "COPILOT_PROVIDER_TYPE": "openai",
        "COPILOT_PROVIDER_WIRE_API": "responses",
        "COPILOT_PROVIDER_BASE_URL": host,
        "COPILOT_MODEL": model,
    }


def main(argv: list[str]) -> None:
    if argv and argv[0] in {"-h", "--help"}:
        print(usage())
        sys.exit(0)

    provider, model, copilot_args = parse_invocation(argv)
    source = "command line"
    if not model:
        model, source = model_from_startup_config()
        if not model:
            sys.exit(
                "No model was given and none is set in Copilot's startup configuration.\n"
                "Pass a model id, set COPILOT_MODEL, or set \"model\" in one of:\n"
                "  .github/copilot/settings.local.json\n"
                "  .github/copilot/settings.json\n"
                "  ~/.copilot/settings.json\n"
                "When COPILOT_HOME is set, the user file is $COPILOT_HOME/settings.json."
            )
    if not model.strip():
        sys.exit("MODEL must be a Bedrock model id.")

    if provider is None:
        provider = derive_provider(model)
        if provider is None:
            sys.exit(
                f"Cannot derive a provider from model {model!r}.\n"
                "Expected an anthropic., openai., or xai. model id, "
                "or pass claude, codex, or grok."
            )
        print(
            f"copilot-bedrock: derived provider {provider} from {model} ({source})",
            file=sys.stderr,
        )
    elif source != "command line":
        print(f"copilot-bedrock: using model {model} from {source}", file=sys.stderr)

    region = resolve_region()
    smoke_test_credentials(region)
    from aws_bedrock_token_generator import provide_token

    token = provide_token(region=region)
    env = provider_env(provider, model, region)
    env["COPILOT_PROVIDER_API_KEY"] = token

    os.environ.pop("COPILOT_PROVIDER_WIRE_API", None)
    os.environ.update(env)
    os.execvp("copilot", ["copilot", *copilot_args])


if __name__ == "__main__":
    main(sys.argv[1:])

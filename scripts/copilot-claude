#!/usr/bin/env bash
# Launch Copilot CLI with a Bedrock Claude model.
# Usage: copilot-claude [MODEL] [copilot args...]
# MODEL defaults to Copilot's project or user settings.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "usage: copilot-claude [MODEL] [copilot args...]"
  echo "When MODEL is omitted, \"model\" is read from Copilot startup settings."
  exit 0
fi

exec "$here/copilot-bedrock" claude "$@"

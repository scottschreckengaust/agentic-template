#!/usr/bin/env bash
# Launch Copilot CLI with a Bedrock Claude model.
# Usage: copilot-claude MODEL [copilot args...]
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
  echo "usage: copilot-claude MODEL [copilot args...]" >&2
  exit 2
fi

exec "$here/copilot-bedrock" claude "$@"
